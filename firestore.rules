rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper functions for entity validation
    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'role', 'displayName', 'email'])
        && data.userId is string && data.userId.size() <= 128
        && data.role in ['Freelancer', 'Client']
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 150;
    }

    function isValidJob(data) {
      return data.keys().hasAll(['id', 'title', 'description', 'roleCategory', 'clientId', 'status'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.description is string && data.description.size() <= 2000
        && data.roleCategory is string && data.roleCategory.size() <= 100
        && data.clientId is string && data.clientId.size() <= 128
        && data.status in ['Open', 'InReview', 'Closed'];
    }

    function isValidProposal(data) {
      return data.keys().hasAll(['id', 'jobId', 'freelancerId', 'freelancerName', 'coverNote', 'proposedRateMinor'])
        && data.id is string && data.id.size() <= 128
        && data.jobId is string && data.jobId.size() <= 128
        && data.freelancerId is string && data.freelancerId.size() <= 128
        && data.freelancerName is string && data.freelancerName.size() <= 150
        && data.coverNote is string && data.coverNote.size() <= 2000
        && data.proposedRateMinor is number && data.proposedRateMinor >= 0;
    }

    function isValidContract(data) {
      return data.keys().hasAll(['id', 'clientId', 'clientName', 'freelancerId', 'freelancerName', 'status'])
        && data.id is string && data.id.size() <= 128
        && data.clientId is string && data.clientId.size() <= 128
        && data.clientName is string && data.clientName.size() <= 150
        && data.freelancerId is string && data.freelancerId.size() <= 128
        && data.freelancerName is string && data.freelancerName.size() <= 150
        && data.status in ['Active', 'Completed', 'Draft'];
    }

    function isValidMilestone(data) {
      return data.keys().hasAll(['id', 'contractId', 'title', 'contractValueMinor', 'state'])
        && data.id is string && data.id.size() <= 128
        && data.contractId is string && data.contractId.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.contractValueMinor is number && data.contractValueMinor >= 0
        && data.state in ['Unfunded', 'Funded', 'InProgress', 'Submitted', 'ApprovedReleased', 'Disputed', 'RefundedCancelled'];
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUserProfile(incoming());
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUserProfile(incoming());
    }

    // Jobs
    match /jobs/{jobId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(jobId) && incoming().clientId == request.auth.uid && isValidJob(incoming());
      allow update: if isSignedIn() && isValidId(jobId) && existing().clientId == request.auth.uid && isValidJob(incoming());

      // Proposals subcollection
      match /proposals/{proposalId} {
        allow get: if isSignedIn() && (existing().freelancerId == request.auth.uid || get(/databases/$(database)/documents/jobs/$(jobId)).data.clientId == request.auth.uid);
        allow list: if isSignedIn() && (resource.data.freelancerId == request.auth.uid || get(/databases/$(database)/documents/jobs/$(jobId)).data.clientId == request.auth.uid);
        allow create: if isSignedIn() && isValidId(proposalId) && incoming().freelancerId == request.auth.uid && isValidProposal(incoming());
        allow update: if isSignedIn() && isValidId(proposalId) && existing().freelancerId == request.auth.uid && isValidProposal(incoming());
      }
    }

    // Contracts
    match /contracts/{contractId} {
      allow get: if isSignedIn() && (existing().clientId == request.auth.uid || existing().freelancerId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.clientId == request.auth.uid || resource.data.freelancerId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(contractId) && (incoming().clientId == request.auth.uid || incoming().freelancerId == request.auth.uid) && isValidContract(incoming());
      allow update: if isSignedIn() && isValidId(contractId) && (existing().clientId == request.auth.uid || existing().freelancerId == request.auth.uid) && isValidContract(incoming());

      // Milestones subcollection
      match /milestones/{milestoneId} {
        allow get, list: if isSignedIn() && (
          get(/databases/$(database)/documents/contracts/$(contractId)).data.clientId == request.auth.uid ||
          get(/databases/$(database)/documents/contracts/$(contractId)).data.freelancerId == request.auth.uid
        );
        allow create, update: if isSignedIn() && isValidId(milestoneId) && (
          get(/databases/$(database)/documents/contracts/$(contractId)).data.clientId == request.auth.uid ||
          get(/databases/$(database)/documents/contracts/$(contractId)).data.freelancerId == request.auth.uid
        ) && isValidMilestone(incoming());
      }
    }
  }
}
